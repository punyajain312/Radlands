# ── Radlands Frontend — Environment Variables ──────────────────────────────
# Copy this file to `.env` and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
#
# NEVER commit your real .env file — add it to .gitignore.
# ────────────────────────────────────────────────────────────────────────────

# Google OAuth Client ID
# Must be the SAME value as GOOGLE_CLIENT_ID in the backend .env.
# Get it from: https://console.cloud.google.com → APIs & Services → Credentials
# Under "Authorised JavaScript origins" add: http://localhost:3000
# Under "Authorised redirect URIs" add:     http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
